#!/usr/bin/env bash
# cmux-context - Visualize Claude Code context usage across all cmux workspaces
set -uo pipefail

VERSION="2.1.0"

# Per-user temp files (avoid symlink attacks and multi-user collisions)
_tmpdir="${TMPDIR:-/tmp}/cmux-context-${UID}"
mkdir -p "$_tmpdir" 2>/dev/null
chmod 700 "$_tmpdir" 2>/dev/null
PIDFILE="$_tmpdir/daemon.pid"
WSFILE="$_tmpdir/daemon.ws"
CONFFILE="$_tmpdir/daemon.conf"

DEFAULT_INTERVAL=10

# --- Colors (terminal output) ---
G="\033[38;2;151;201;195m"  # green (low usage)
Y="\033[38;2;229;192;123m"  # yellow (medium usage)
R="\033[38;2;224;108;117m"  # red (high usage)
D="\033[38;2;74;88;92m"     # dim gray
W="\033[1m"                 # bold
O="\033[0m"                 # reset

# --- Sidebar color hex codes ---
COLOR_GREEN="#97C9C3"
COLOR_YELLOW="#E5C07B"
COLOR_RED="#E06C75"

# Color based on usage percentage (terminal)
pct_color() {
    local pct=$1
    if (( pct >= 80 )); then echo -ne "$R"
    elif (( pct >= 50 )); then echo -ne "$Y"
    else echo -ne "$G"
    fi
}

# Hex color based on usage percentage (sidebar)
pct_hex() {
    local pct=$1
    if (( pct >= 80 )); then echo "$COLOR_RED"
    elif (( pct >= 50 )); then echo "$COLOR_YELLOW"
    else echo "$COLOR_GREEN"
    fi
}

# Draw progress bar (20 chars wide)
draw_bar() {
    local pct=$1 width=20
    local filled=$(( (pct * width + 50) / 100 ))
    (( filled > width )) && filled=$width
    (( filled < 0 )) && filled=0
    local bar=""
    for (( i=1; i<=width; i++ )); do
        if (( i <= filled )); then bar+="█"; else bar+="░"; fi
    done
    echo -n "$bar"
}

# --- Help ---
show_help() {
    echo "Usage: cmux-context [command] [options]"
    echo ""
    echo "Display Claude Code context usage for all cmux workspaces."
    echo ""
    echo "Commands:"
    echo "  (none)          One-shot terminal output (default)"
    echo "  start           Start sidebar daemon (creates a dedicated workspace)"
    echo "  stop            Stop daemon and clear sidebar indicators"
    echo "  status          Show daemon status"
    echo ""
    echo "Options (for start):"
    echo "  --interval N    Update interval in seconds (default: $DEFAULT_INTERVAL)"
    echo "  --progress      Show progress bar (default: status pill only)"
    echo "  -h, --help      Show this help message"
    echo "  -v, --version   Show version"
    echo ""
    echo "Examples:"
    echo "  cmux-context                        # one-shot terminal display"
    echo "  cmux-context start                  # start sidebar daemon (10s interval)"
    echo "  cmux-context start --interval 5     # 5s interval"
    echo "  cmux-context start --progress       # status pill + progress bar"
    echo "  cmux-context stop                   # stop daemon, clear sidebar"
}

# --- Workspace parsing helpers ---

# Get all workspace refs
get_workspace_refs() {
    cmux list-workspaces 2>/dev/null | grep -oE 'workspace:[0-9]+' || true
}

# Parse context % from a workspace screen. Outputs percentage (integer) or empty.
parse_context_pct() {
    local screen="$1"
    local ctx_line
    ctx_line=$(echo "$screen" | grep -E '[0-9]+% \|' | tail -1) || true
    [ -z "$ctx_line" ] && return
    local raw
    raw=$(echo "$ctx_line" | grep -oE '[0-9]+%' | head -1 | tr -d '%')
    # Validate: must be a non-negative integer
    [[ "$raw" =~ ^[0-9]+$ ]] && echo "$raw"
}

# Get all surface refs in a workspace (across all panes).
# If $2 is given, only surfaces whose listing line matches $2 are returned.
get_workspace_surfaces() {
    local ws_ref="$1"
    local filter="${2:-}"
    local panes
    panes=$(cmux list-panes --workspace "$ws_ref" 2>/dev/null | grep -oE 'pane:[0-9]+') || true
    [ -z "$panes" ] && return

    while IFS= read -r pane_ref; do
        [ -z "$pane_ref" ] && continue
        local output
        output=$(cmux list-pane-surfaces --workspace "$ws_ref" --pane "$pane_ref" 2>/dev/null) || continue
        if [ -n "$filter" ]; then
            echo "$output" | grep "$filter" | grep -oE 'surface:[0-9]+' || true
        else
            echo "$output" | grep -oE 'surface:[0-9]+' || true
        fi
    done <<< "$panes"
}

# --- Sidebar update for one workspace ---

update_sidebar_for_workspace() {
    local ws_ref="$1"

    # Enumerate Claude Code surfaces across all panes
    local surfaces
    surfaces=$(get_workspace_surfaces "$ws_ref" "Claude Code")

    local idx=0 max_pct=""

    if [ -n "$surfaces" ]; then
        while IFS= read -r surface_ref; do
            [ -z "$surface_ref" ] && continue
            local screen
            screen=$(cmux read-screen --workspace "$ws_ref" --surface "$surface_ref" --lines 10 2>/dev/null) || continue
            local pct
            pct=$(parse_context_pct "$screen")
            [ -z "$pct" ] && continue

            local hex_color
            hex_color=$(pct_hex "$pct")
            cmux set-status "ctx${idx}" "${pct}%" --icon brain --color "$hex_color" --workspace "$ws_ref" &>/dev/null || true

            if [ -z "$max_pct" ] || (( pct > max_pct )); then
                max_pct="$pct"
            fi
            (( idx++ )) || true
        done <<< "$surfaces"
    else
        # Fallback: workspace-level read (single surface / no pane info)
        local screen
        screen=$(cmux read-screen --workspace "$ws_ref" --lines 10 2>/dev/null) || return
        local pct
        pct=$(parse_context_pct "$screen")
        if [ -n "$pct" ]; then
            local hex_color
            hex_color=$(pct_hex "$pct")
            cmux set-status "ctx0" "${pct}%" --icon brain --color "$hex_color" --workspace "$ws_ref" &>/dev/null || true
            max_pct="$pct"
            (( idx++ )) || true
        fi
    fi

    # Clear stale ctx keys (handles instances being closed)
    for (( i=idx; i<idx+3; i++ )); do
        cmux clear-status "ctx${i}" --workspace "$ws_ref" &>/dev/null || true
    done
    # Clear legacy v2.0 key
    cmux clear-status ctx --workspace "$ws_ref" &>/dev/null || true

    if [ -z "$max_pct" ]; then
        cmux clear-progress --workspace "$ws_ref" &>/dev/null || true
        return
    fi

    # Progress bar (opt-in with --progress)
    if [ -f "$CONFFILE" ] && grep -q 'show_progress=1' "$CONFFILE" 2>/dev/null; then
        local progress
        progress=$(awk -v pct="$max_pct" 'BEGIN { printf "%.2f", pct / 100 }')
        cmux set-progress "$progress" --workspace "$ws_ref" &>/dev/null || true
    else
        cmux clear-progress --workspace "$ws_ref" &>/dev/null || true
    fi
}

# --- Cleanup all workspaces ---

cleanup_all_workspaces() {
    local ws_refs
    ws_refs=$(get_workspace_refs)
    [ -z "$ws_refs" ] && return

    while IFS= read -r ws_ref; do
        [ -z "$ws_ref" ] && continue
        # Clear all ctx keys (legacy + indexed)
        cmux clear-status ctx --workspace "$ws_ref" &>/dev/null || true
        for (( i=0; i<5; i++ )); do
            cmux clear-status "ctx${i}" --workspace "$ws_ref" &>/dev/null || true
        done
        cmux clear-progress --workspace "$ws_ref" &>/dev/null || true
    done <<< "$ws_refs"
}

# --- Daemon (runs in foreground inside dedicated workspace) ---

cmd_run() {
    local interval="${1:-$DEFAULT_INTERVAL}"

    echo $$ > "$PIDFILE"
    trap 'cleanup_all_workspaces; rm -f "$PIDFILE"; exit 0' SIGTERM SIGINT EXIT

    printf "${W}cmux-context daemon${O} running (interval ${interval}s, PID $$)\n"
    printf "${D}Press Ctrl+C to stop${O}\n\n"

    while true; do
        local ws_refs
        ws_refs=$(get_workspace_refs)

        if [ -n "$ws_refs" ]; then
            while IFS= read -r ws_ref; do
                [ -z "$ws_ref" ] && continue
                update_sidebar_for_workspace "$ws_ref"
            done <<< "$ws_refs"
        fi

        sleep "$interval"
    done
}

# --- Start: create dedicated workspace ---

cmd_start() {
    local interval="$DEFAULT_INTERVAL"
    local show_progress=0

    # Parse options
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --interval)
                shift
                interval="${1:-$DEFAULT_INTERVAL}"
                ;;
            --progress)
                show_progress=1
                ;;
        esac
        shift
    done

    # Validate interval
    if ! [[ "$interval" =~ ^[0-9]+$ ]] || (( interval < 1 )); then
        echo "Error: --interval must be a positive integer." >&2
        exit 1
    fi

    # Write config
    echo "show_progress=$show_progress" > "$CONFFILE"

    # Check if already running
    if [ -f "$PIDFILE" ]; then
        local old_pid
        old_pid=$(cat "$PIDFILE")
        if kill -0 "$old_pid" 2>/dev/null; then
            echo "Daemon already running (PID $old_pid). Use 'cmux-context stop' first."
            exit 1
        fi
        rm -f "$PIDFILE" "$WSFILE"
    fi

    # Verify cmux is available
    cmux list-workspaces &>/dev/null || {
        echo "Error: Cannot connect to cmux. Is cmux running?" >&2
        exit 1
    }

    # Resolve self path (absolute)
    local self
    self=$(command -v cmux-context 2>/dev/null)
    if [ -z "$self" ]; then
        self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
    fi

    # Create dedicated workspace running the daemon
    local ws_result
    ws_result=$(cmux new-workspace --command "\"$self\" _run $interval" 2>&1)
    local ws_ref
    ws_ref=$(echo "$ws_result" | grep -oE 'workspace:[0-9]+' || true)

    if [ -z "$ws_ref" ]; then
        echo "Error: Failed to create workspace: $ws_result" >&2
        exit 1
    fi

    # Save workspace ref for stop command
    echo "$ws_ref" > "$WSFILE"

    # Rename the workspace
    cmux rename-workspace --workspace "$ws_ref" "ctx-monitor" &>/dev/null || true

    # Wait for PID file from the daemon
    local waited=0
    while [ ! -f "$PIDFILE" ] && (( waited < 10 )); do
        sleep 0.5
        (( waited++ )) || true
    done

    if [ -f "$PIDFILE" ]; then
        local daemon_pid
        daemon_pid=$(cat "$PIDFILE")
        echo "cmux-context daemon started (PID $daemon_pid, workspace $ws_ref, interval ${interval}s)"
    else
        echo "Daemon workspace created ($ws_ref) but PID not yet available."
    fi

    # Switch back to the original workspace
    local current_ws="${CMUX_WORKSPACE_ID:-}"
    if [ -n "$current_ws" ]; then
        cmux select-workspace --workspace "$current_ws" &>/dev/null || true
    fi
}

cmd_stop() {
    if [ ! -f "$PIDFILE" ] && [ ! -f "$WSFILE" ]; then
        echo "No daemon running."
        cleanup_all_workspaces
        return
    fi

    # Kill the daemon process
    if [ -f "$PIDFILE" ]; then
        local pid
        pid=$(cat "$PIDFILE")
        if kill -0 "$pid" 2>/dev/null; then
            kill "$pid" 2>/dev/null
            local waited=0
            while kill -0 "$pid" 2>/dev/null && (( waited < 3 )); do
                sleep 1
                (( waited++ ))
            done
            if kill -0 "$pid" 2>/dev/null; then
                kill -9 "$pid" 2>/dev/null || true
            fi
        fi
        rm -f "$PIDFILE"
    fi

    # Close the dedicated workspace
    if [ -f "$WSFILE" ]; then
        local ws_ref
        ws_ref=$(cat "$WSFILE")
        if [ -n "$ws_ref" ]; then
            cmux close-workspace --workspace "$ws_ref" &>/dev/null || true
        fi
        rm -f "$WSFILE"
    fi

    # Cleanup config and sidebar
    rm -f "$CONFFILE"
    cleanup_all_workspaces
    echo "Daemon stopped. Sidebar indicators cleared."
}

cmd_status() {
    if [ ! -f "$PIDFILE" ]; then
        echo "Daemon is not running."
        return
    fi

    local pid
    pid=$(cat "$PIDFILE")

    if kill -0 "$pid" 2>/dev/null; then
        local ws_ref=""
        [ -f "$WSFILE" ] && ws_ref=$(cat "$WSFILE")
        echo "Daemon is running (PID $pid${ws_ref:+, $ws_ref})."
    else
        echo "Daemon is not running (stale PID file)."
        rm -f "$PIDFILE"
    fi
}

# --- One-shot terminal output (original behavior) ---

# Render one Claude instance line for oneshot output.
# Usage: _render_oneshot_line <screen_content> <ctx_pct>
# Side effect: sets rate_5h / rate_7d via dynamic scoping.
_render_oneshot_line() {
    local screen="$1"
    local ctx_pct="$2"

    local ctx_line
    ctx_line=$(echo "$screen" | grep -E '[0-9]+% \|' | tail -1) || true
    local lines_info
    lines_info=$(echo "$ctx_line" | grep -oE '\+[0-9]+/-[0-9]+' || echo "")

    local model
    model=$(echo "$screen" | grep -oE '(Opus|Sonnet|Haiku) [0-9.]+' | head -1) || true
    [ -z "$model" ] && model="unknown"

    if [ -z "$rate_5h" ]; then
        rate_5h=$(echo "$screen" | grep -E '5h .*(▰|▱)' | head -1) || true
        rate_7d=$(echo "$screen" | grep -E '7d .*(▰|▱)' | head -1) || true
    fi

    local color
    color=$(pct_color "$ctx_pct")
    printf "  ${color}"
    draw_bar "$ctx_pct"
    printf " %3d%%${O}" "$ctx_pct"
    printf "  ${D}${model}${O}"
    [ -n "$lines_info" ] && printf "  ${D}${lines_info}${O}"
    printf "\n"
}

cmd_oneshot() {
    local workspaces
    workspaces=$(cmux list-workspaces 2>/dev/null) || {
        echo "Error: Cannot connect to cmux. Is cmux running?" >&2
        echo "Install cmux from https://cmux.co" >&2; exit 1
    }

    echo ""
    printf "${W}  cmux Context Monitor${O}\n"
    printf "${D}  ────────────────────────────────────────────────────────${O}\n"

    local rate_5h="" rate_7d=""

    while IFS= read -r line; do
        local ws_ref
        ws_ref=$(echo "$line" | grep -oE 'workspace:[0-9]+') || true
        [ -z "$ws_ref" ] && continue

        local ws_name
        ws_name=$(echo "$line" | sed -E 's/^[* ]+workspace:[0-9]+[[:space:]]*//' | sed -E 's/\[.*\]//g' | xargs)
        ws_name=$(echo "$ws_name" | sed $'s/[\xe2\xa0\x80-\xe2\xa3\xbf]//g' | sed 's/^[[:space:]]*//')
        [ -z "$ws_name" ] && ws_name="$ws_ref"

        local is_current=""
        echo "$line" | grep -q '^\*' && is_current=" ◀"

        # Enumerate Claude Code surfaces across all panes
        local surfaces
        surfaces=$(get_workspace_surfaces "$ws_ref" "Claude Code")

        local printed_header=0

        if [ -n "$surfaces" ]; then
            while IFS= read -r surface_ref; do
                [ -z "$surface_ref" ] && continue
                local screen
                screen=$(cmux read-screen --workspace "$ws_ref" --surface "$surface_ref" --lines 10 2>/dev/null) || continue
                local ctx_pct
                ctx_pct=$(parse_context_pct "$screen")
                [ -z "$ctx_pct" ] && continue

                if (( printed_header == 0 )); then
                    printf "\n  ${W}%-28s${O}${D}${is_current}${O}\n" "$ws_name"
                    printed_header=1
                fi

                _render_oneshot_line "$screen" "$ctx_pct"
            done <<< "$surfaces"
        else
            # Fallback: workspace-level read
            local screen
            screen=$(cmux read-screen --workspace "$ws_ref" --lines 10 2>/dev/null) || continue
            local ctx_pct
            ctx_pct=$(parse_context_pct "$screen")
            [ -z "$ctx_pct" ] && continue

            printf "\n  ${W}%-28s${O}${D}${is_current}${O}\n" "$ws_name"
            _render_oneshot_line "$screen" "$ctx_pct"
        fi

    done <<< "$workspaces"

    if [ -n "$rate_5h" ] || [ -n "$rate_7d" ]; then
        printf "\n${D}  ────────────────────────────────────────────────────────${O}\n"
        printf "  ${W}Rate Limits${O} ${D}(shared)${O}\n"
        [ -n "$rate_5h" ] && printf "  %s\n" "$rate_5h"
        [ -n "$rate_7d" ] && printf "  %s\n" "$rate_7d"
    fi

    echo ""
}

# --- Entry point ---

case "${1:-}" in
    -h|--help)
        show_help
        ;;
    -v|--version)
        echo "cmux-context $VERSION"
        ;;
    start)
        shift
        cmd_start "$@"
        ;;
    stop)
        cmd_stop
        ;;
    status)
        cmd_status
        ;;
    _run)
        # Internal: daemon foreground mode (runs in dedicated workspace)
        shift
        cmd_run "$@"
        ;;
    "")
        cmd_oneshot
        ;;
    *)
        echo "Unknown command: $1" >&2
        echo "Run 'cmux-context --help' for usage." >&2
        exit 1
        ;;
esac
